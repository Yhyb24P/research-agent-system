.venv/
.pytest_cache/
.mypy_cache/
__pycache__/
# Qualification procedures are the only tracked documentation tree. Other
# local notes under docs/ remain ignored unless governance is changed explicitly.
docs/*
!docs/qualification/
!docs/qualification/**
*.py[cod]
release-manifest.json
*-evidence.json
*-evidence-check.json
# Runtime state and SQLite sidecars must never enter the release baseline.
*.db
*.db-wal
*.db-shm
/backup/
/backups/
