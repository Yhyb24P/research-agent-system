.venv/
.pytest_cache/
.mypy_cache/
__pycache__/
# Tracked documentation trees: docs/qualification/ (frozen legacy) and
# docs/v2/ (active Rust v2 roadmap). Other local notes under docs/ remain
# ignored unless governance is changed explicitly.
docs/*
!docs/qualification/
!docs/qualification/**
!docs/v2/
!docs/v2/**
*.py[cod]
release-manifest.json
*-evidence.json
*-evidence-check.json
# Runtime state and SQLite sidecars must never enter the release baseline.
*.db
*.db-wal
*.db-shm
/backup/
/backups/
