{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchd.local/schemas/qualification_evidence.schema.json",
  "title": "QualificationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "gate_id", "candidate_commit", "candidate_tag", "environment_fingerprint", "started_at", "completed_at", "producer", "tool_versions", "checks", "artifacts", "result"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^qe_[A-Za-z0-9_.-]+$"},
    "gate_id": {"type": "string", "pattern": "^(IQ|DQ|RQ)[0-9]{2}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9A-Za-z.-]+$"},
    "environment_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id"],
      "properties": {
        "actor_type": {"enum": ["HUMAN", "SYSTEM", "AGENT"]},
        "actor_id": {"type": "string", "minLength": 1},
        "implementation": {"type": ["string", "null"]}
      }
    },
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "severity", "expected", "observed", "result"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^(IQ|DQ|RQ)[0-9]{2}-[0-9]{2,}$"},
          "severity": {"enum": ["HARD", "MAJOR", "ADVISORY"]},
          "expected": {},
          "observed": {},
          "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
          "log_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "notes": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "path": {"type": "string", "minLength": 1},
          "classification": {"type": ["string", "null"]}
        }
      }
    },
    "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "supersedes_evidence_id": {"type": ["string", "null"], "pattern": "^qe_[A-Za-z0-9_.-]+$"}
  }
}
