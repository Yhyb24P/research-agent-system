{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchd.local/schemas/qualification_plan.schema.json",
  "title": "QualificationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_commit", "gates"],
  "properties": {
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tag": {"type": ["string", "null"]},
    "status": {"enum": ["PLANNED", "IN_PROGRESS", "COMPLETED", "BLOCKED"]},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "title", "severity", "dependencies", "status"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^(IQ|DQ|RQ)[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["HARD", "RELEASE"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "BLOCKED", "PASSED", "FAILED", "INVALIDATED", "WAIVED"]},
          "accepted_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
